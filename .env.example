# Copy to .env and fill in.
DB_PASSWORD=change-me
SUBTRACK_USERNAME=admin
# BCrypt hash of your password. Keep the single quotes: the hash contains "$".
# Generate it with:  docker run --rm httpd:2.4-alpine htpasswd -bnBC 10 "" 'your-password' | tr -d ':\n'
SUBTRACK_PASSWORD_HASH='$2y$10$replace.with.your.own.hash.............................'
TZ=Europe/Madrid
